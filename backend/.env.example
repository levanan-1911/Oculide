# ============================================================
# Backend .env.example — copy to .env and fill in real values
# ============================================================

# ── SQL Server ────────────────────────────────────────────
DATABASE_DRIVER=ODBC+Driver+18+for+SQL+Server
DATABASE_SERVER=sqlserver
DATABASE_NAME=ExamSystem
DATABASE_USERNAME=sa
DATABASE_PASSWORD=YourStrong@Passw0rd
DATABASE_ENCRYPT=no
DATABASE_TRUST_SERVER=yes
DATABASE_CONNECTION_TIMEOUT=30

# ── JWT ───────────────────────────────────────────────────
# IMPORTANT: Generate a real secret in production!
# e.g.  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── LiveKit ───────────────────────────────────────────────
LIVEKIT_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── App ───────────────────────────────────────────────────
APP_NAME=Oculide API
APP_VERSION=1.0.0
DEBUG=true

# ── Docker Sandbox (for Celery grading worker) ────────────
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_MEM_LIMIT=128m
SANDBOX_TIME_LIMIT_S=10
SANDBOX_NANO_CPUS=500000000

# ── SQL Server SA Password (also used by docker-compose) ──
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# API base URL (Để trống để Next.js tự động proxy qua cấu hình rewrites)
NEXT_PUBLIC_API_URL="https://api.oculide.id.vn"

# WebSocket base URL (used for exam & proctoring connections)
# ĐỔI THÀNH wss://... (bỏ https:// thay bằng wss://)
NEXT_PUBLIC_WS_URL=wss://api.oculide.id.vn

# LiveKit server URL
NEXT_PUBLIC_LIVEKIT_URL=wss://oculide-exam-4eu7af2s.livekit.cloud
